targetScope = 'resourceGroup'

//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Server parameters forwarded verbatim to the AVM PostgreSQL flexible server configurations array, using the AVM item shape with name, source, and value fields. Commonly used to allow-list extensions via the azure.extensions parameter (for example to enable pgvector). Defaults to an empty array (no extra server configuration).')
param postgreSqlServerConfigurations array = []

//////////////////////////////////////////
// PostgreSQL variables
//////////////////////////////////////////

var username = context.resource.properties.username
var password = context.resource.properties.password
var database = context.resource.properties.?database ?? 'postgres_db'
var size = context.resource.properties.?size ?? 'S'
var port = 5432

// The server name must match the name the Azure Recipe Pack generated before this
// Recipe replaced its inline AVM reference, otherwise redeploying an existing
// resource would strand the server it already provisioned. `resourceNameHash` is a
// stable hash of the Azure scope plus the Radius resource ID, and is the same value
// the Recipe Pack interpolated as `{{context.azure.resourceNameHash}}`.
var serverName = 'pgsql-${context.azure.resourceNameHash}'

//////////////////////////////////////////
// Pre-created databases
//
// Azure creates a `postgres` database on every PostgreSQL flexible server. Asking
// Azure to create it a second time fails the whole deployment with
// `InvalidParameterValue: Invalid value given for parameter databaseName`, after the
// server itself has already been created and billed. `postgres` is a perfectly
// usable application database, so when it is requested this Recipe provisions the
// server with no child database and binds the application to the one Azure made.
//
// Azure also pre-creates `azure_maintenance` and `azure_sys`, and PostgreSQL itself
// pre-creates `template0` and `template1`. Those are internal, and `template0`
// refuses connections outright, so they are deliberately NOT remapped here: binding
// an application to them would silently produce a broken deployment. They continue
// to fail at Azure, and are called out in the resource type README. Rejecting them
// up front needs a denylist the Resource Type schema cannot express today, because
// Radius rejects `not`/`oneOf` and Go RE2 has no negative lookahead.
//////////////////////////////////////////

var isPreCreatedDatabase = toLower(database) == 'postgres'

//////////////////////////////////////////
// PostgreSQL flexible server
//////////////////////////////////////////

module postgresql 'br:mcr.microsoft.com/bicep/avm/res/db-for-postgre-sql/flexible-server:0.15.2' = {
  name: 'pgsql-${uniqueString(context.resource.id)}'
  params: {
    name: serverName
    administratorLogin: username
    administratorLoginPassword: password
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
    }
    skuName: size == 'S' ? 'Standard_B1ms' : 'Standard_D2ds_v5'
    tier: size == 'S' ? 'Burstable' : 'GeneralPurpose'
    databases: isPreCreatedDatabase ? [] : [
      {
        name: database
      }
    ]
    version: '16'
    availabilityZone: -1
    highAvailability: 'Disabled'
    geoRedundantBackup: 'Disabled'
    storageSizeGB: 32
    publicNetworkAccess: 'Enabled'
    firewallRules: [
      {
        name: 'allow-all'
        startIpAddress: '0.0.0.0'
        endIpAddress: '255.255.255.255'
      }
    ]
    enableAdvancedThreatProtection: false
    enableTelemetry: false
    lock: {
      kind: 'None'
    }
    configurations: postgreSqlServerConfigurations
  }
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

output result object = {
  resources: [
    postgresql.outputs.resourceId
  ]
  values: {
    // AVM types `fqdn` as nullable because it reads through `tryGet`, but a flexible
    // server created with public network access always reports one.
    host: postgresql.outputs.?fqdn ?? ''
    port: port
    database: database
  }
}
