@description('Information about the resource calling this Recipe. Generated by Radius.')
@secure()
param context object

@description('Stable Azure server name. The Recipe Pack supplies its existing hash-based name; standalone Recipes derive a name from the Radius resource ID.')
param name string = 'pgsql-${uniqueString(context.resource.id)}'

@description('Operator server settings in AVM name, source, value form. These override application settings.')
param configurations array = []

var properties = context.resource.properties
var database = properties.?database ?? 'postgres_db'
var initSql = properties.?initSql ?? ''
var hasInitSql = !empty(initSql)
var extensions = properties.?extensions ?? []
var serverSettings = properties.?serverSettings ?? {}
var operatorNames = map(configurations, config => config.name)
var applicationSettings = filter(items(serverSettings), setting => !contains(operatorNames, setting.key) && setting.key != 'azure.extensions' && setting.key != 'require_secure_transport')
var applicationConfigurations = [
  for setting in applicationSettings: {
    name: setting.key
    source: 'user-override'
    value: setting.value
  }
]
// Keep operator pins, but never let a generic app setting bypass tls or extensions.
var transportConfiguration = contains(operatorNames, 'require_secure_transport') ? [] : [
  {
    name: 'require_secure_transport'
    source: 'user-override'
    value: (properties.?tls ?? 'required') == 'optional' ? 'OFF' : 'ON'
  }
]
var extensionConfiguration = contains(operatorNames, 'azure.extensions') ? [] : [
  {
    name: 'azure.extensions'
    source: 'user-override'
    value: join(extensions, ',')
  }
]

module server 'br/public:avm/res/db-for-postgre-sql/flexible-server:0.15.2' = {
  name: name
  params: {
    name: name
    administratorLogin: properties.username
    administratorLoginPassword: properties.password
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
    }
    skuName: (properties.?size ?? 'S') == 'S' ? 'Standard_B1ms' : 'Standard_D2ds_v5'
    tier: (properties.?size ?? 'S') == 'S' ? 'Burstable' : 'GeneralPurpose'
    databases: [
      {
        name: database
      }
    ]
    version: '16'
    availabilityZone: -1
    highAvailability: 'Disabled'
    geoRedundantBackup: 'Disabled'
    storageSizeGB: 32
    publicNetworkAccess: 'Enabled'
    firewallRules: [
      {
        name: 'allow-all'
        startIpAddress: '0.0.0.0'
        endIpAddress: '255.255.255.255'
      }
    ]
    enableAdvancedThreatProtection: false
    enableTelemetry: false
    lock: {
      kind: 'None'
    }
    configurations: concat(configurations, applicationConfigurations, transportConfiguration, extensionConfiguration)
  }
}

resource initialize 'Microsoft.Resources/deploymentScripts@2023-08-01' = if (hasInitSql) {
  name: '${name}-init'
  location: resourceGroup().location
  kind: 'AzureCLI'
  properties: {
    azCliVersion: '2.77.0'
    timeout: 'PT15M'
    cleanupPreference: 'Always'
    retentionInterval: 'P1D'
    forceUpdateTag: uniqueString(initSql, database)
    environmentVariables: [
      {
        name: 'PGHOST'
        value: server.outputs.fqdn
      }
      {
        name: 'PGPORT'
        value: '5432'
      }
      {
        name: 'PGDATABASE'
        value: database
      }
      {
        name: 'PGUSER'
        value: properties.username
      }
      {
        name: 'PGPASSWORD'
        secureValue: context.resource.properties.password
      }
      {
        name: 'INIT_SQL'
        secureValue: context.resource.properties.?initSql ?? ''
      }
      {
        name: 'PGSSLMODE'
        value: 'require'
      }
      {
        name: 'PGCONNECT_TIMEOUT'
        value: '15'
      }
    ]
    scriptContent: loadTextContent('initialize-database.sh')
  }
}

output result object = {
  resources: concat(
    [server.outputs.resourceId],
    hasInitSql ? [initialize!.id] : []
  )
  values: {
    host: server.outputs.fqdn
    port: 5432
    database: database
  }
}
