@description('Information about the resource calling this Recipe. Generated by Radius.')
@secure()
param context object

@description('Stable Azure server name. Uses the Radius Azure resource name hash, or hashes the subscription, resource group, and Radius resource ID when the runtime hash is absent or empty.')
param postgreSqlServerName string = 'pgsql-${!empty(context.?azure.?resourceNameHash) ? context.?azure.?resourceNameHash : uniqueString(subscription().id, resourceGroup().id, context.resource.id)}'

@description('Operator server settings in AVM name, source, value form. See the Azure Recipe README for merge and override rules.')
param postgreSqlServerConfigurations array = []

var properties = context.resource.properties
var database = properties.?database ?? 'postgres_db'
var initSql = properties.?initSql ?? ''
var hasInitSql = !empty(trim(initSql))
var extensions = properties.?extensions ?? []
var serverSettings = properties.?serverSettings ?? {}
var operatorConfigurations = [
  for config in filter(postgreSqlServerConfigurations, config => toLower(config.name) != 'port'): toLower(config.name) == 'azure.extensions' && !empty(config.value) && !empty(extensions) ? union(config, {
    value: join(union(map(split(config.value, ','), name => toLower(trim(name))), extensions), ',')
  }) : config
]
var operatorNames = map(operatorConfigurations, config => toLower(config.name))
// Azure resource names and PostgreSQL parameter names are case-insensitive.
var applicationSettings = filter(items(serverSettings), setting => !contains(operatorNames, toLower(setting.key)) && !contains(['azure.extensions', 'require_secure_transport', 'port'], toLower(setting.key)))
var applicationConfigurations = [
  for setting in applicationSettings: {
    name: setting.key
    source: 'user-override'
    value: setting.value
  }
]
var transportConfiguration = contains(operatorNames, 'require_secure_transport') ? [] : [
  {
    name: 'require_secure_transport'
    source: 'user-override'
    value: (properties.?tls ?? 'required') == 'optional' ? 'OFF' : 'ON'
  }
]
// No entry means no update: an empty application list must not clear an existing allow-list.
var extensionConfiguration = contains(operatorNames, 'azure.extensions') || empty(extensions) ? [] : [
  {
    name: 'azure.extensions'
    source: 'user-override'
    value: join(extensions, ',')
  }
]

module server 'br/public:avm/res/db-for-postgre-sql/flexible-server:0.15.2' = {
  name: postgreSqlServerName
  params: {
    name: postgreSqlServerName
    administratorLogin: properties.username
    administratorLoginPassword: properties.password
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
    }
    skuName: (properties.?size ?? 'S') == 'S' ? 'Standard_B1ms' : 'Standard_D2ds_v5'
    tier: (properties.?size ?? 'S') == 'S' ? 'Burstable' : 'GeneralPurpose'
    databases: [
      {
        name: database
      }
    ]
    version: '16'
    availabilityZone: -1
    highAvailability: 'Disabled'
    geoRedundantBackup: 'Disabled'
    storageSizeGB: 32
    publicNetworkAccess: 'Enabled'
    firewallRules: [
      {
        name: 'allow-all'
        startIpAddress: '0.0.0.0'
        endIpAddress: '255.255.255.255'
      }
    ]
    enableAdvancedThreatProtection: false
    enableTelemetry: false
    lock: {
      kind: 'None'
    }
    configurations: concat(operatorConfigurations, applicationConfigurations, transportConfiguration, extensionConfiguration)
  }
}

resource initialize 'Microsoft.Resources/deploymentScripts@2023-08-01' = if (hasInitSql) {
  name: '${postgreSqlServerName}-init'
  location: resourceGroup().location
  kind: 'AzureCLI'
  properties: {
    azCliVersion: '2.77.0'
    timeout: 'PT15M'
    cleanupPreference: 'Always'
    retentionInterval: 'P1D'
    forceUpdateTag: uniqueString(initSql, database)
    environmentVariables: [
      {
        name: 'PGHOST'
        value: server.outputs.fqdn
      }
      {
        name: 'PGPORT'
        value: '5432'
      }
      {
        name: 'PGDATABASE'
        value: database
      }
      {
        name: 'PGUSER'
        value: properties.username
      }
      {
        name: 'PGPASSWORD'
        secureValue: properties.password
      }
      {
        name: 'INIT_SQL'
        secureValue: initSql
      }
      {
        name: 'PGSSLMODE'
        value: 'require'
      }
      {
        name: 'PGCONNECT_TIMEOUT'
        value: '15'
      }
    ]
    scriptContent: loadTextContent('initialize-database.sh')
  }
}

output result object = {
  resources: concat(
    [server.outputs.resourceId],
    hasInitSql ? [initialize!.id] : []
  )
  values: {
    host: server.outputs.fqdn
    port: 5432
    database: database
  }
}
