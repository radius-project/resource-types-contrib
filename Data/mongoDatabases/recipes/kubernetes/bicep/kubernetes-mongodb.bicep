extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

@description('Information about the resource calling this Recipe. Generated by Radius.')
param context object

@description('Name of an existing Kubernetes Secret in the context namespace with a password key for the radius administrator. Keep the Secret and password stable while retaining the data volume.')
@minLength(1)
param mongoCredentialsSecretName string = '${context.resource.name}-mongodb-credentials'

var resourceName = context.resource.name
var namespace = context.runtime.kubernetes.namespace
var database = context.resource.properties.?database ?? 'mongo_db'
var port = 27017
var username = 'radius'
var mongoPassword = base64ToString(credentials.data.password)
var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': context.?application.?name ?? ''
  'radapp.io/environment': context.?environment.?name ?? ''
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': split(context.resource.id, '/')[5]
}

resource credentials 'core/Secret@v1' existing = {
  metadata: {
    name: mongoCredentialsSecretName
    namespace: namespace
  }
}

resource data 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${resourceName}-mongodb-data'
    namespace: namespace
    labels: labels
  }
  spec: {
    accessModes: [
      'ReadWriteOnce'
    ]
    resources: {
      requests: {
        storage: '1Gi'
      }
    }
  }
}

resource mongo 'apps/Deployment@v1' = {
  metadata: {
    name: '${resourceName}-mongodb'
    namespace: namespace
    labels: labels
  }
  spec: {
    replicas: 1
    // Never start two database processes against the same volume.
    strategy: {
      type: 'Recreate'
    }
    selector: {
      matchLabels: {
        'radapp.io/resource': resourceName
        'radapp.io/component': 'mongodb'
      }
    }
    template: {
      metadata: {
        labels: union(labels, { 'radapp.io/component': 'mongodb' })
      }
      spec: {
        automountServiceAccountToken: false
        securityContext: {
          runAsUser: 999
          runAsGroup: 999
          fsGroup: 999
        }
        containers: [
          {
            name: 'mongodb'
            image: 'mongo:8.0'
            ports: [
              {
                containerPort: port
              }
            ]
            env: [
              {
                name: 'MONGO_INITDB_ROOT_USERNAME'
                value: username
              }
              {
                name: 'MONGO_INITDB_ROOT_PASSWORD'
                valueFrom: {
                  secretKeyRef: {
                    name: mongoCredentialsSecretName
                    key: 'password'
                  }
                }
              }
              {
                name: 'MONGO_INITDB_DATABASE'
                value: database
              }
            ]
            volumeMounts: [
              {
                name: 'data'
                mountPath: '/data/db'
              }
            ]
            securityContext: {
              allowPrivilegeEscalation: false
              capabilities: {
                drop: [
                  'ALL'
                ]
              }
            }
            resources: {
              requests: {
                cpu: '100m'
                memory: '256Mi'
              }
              limits: {
                memory: '1Gi'
              }
            }
            startupProbe: {
              exec: {
                command: [
                  'mongosh'
                  '--quiet'
                  '--eval'
                  'const admin = db.getSiblingDB("admin"); if (!admin.auth(process.env.MONGO_INITDB_ROOT_USERNAME, process.env.MONGO_INITDB_ROOT_PASSWORD).ok) { quit(1); } quit(admin.runCommand({ping: 1}).ok ? 0 : 1);'
                ]
              }
              periodSeconds: 5
              failureThreshold: 60
              timeoutSeconds: 5
            }
            readinessProbe: {
              exec: {
                command: [
                  'mongosh'
                  '--quiet'
                  '--eval'
                  'const admin = db.getSiblingDB("admin"); if (!admin.auth(process.env.MONGO_INITDB_ROOT_USERNAME, process.env.MONGO_INITDB_ROOT_PASSWORD).ok) { quit(1); } quit(admin.runCommand({ping: 1}).ok ? 0 : 1);'
                ]
              }
              periodSeconds: 10
              timeoutSeconds: 5
            }
          }
        ]
        volumes: [
          {
            name: 'data'
            persistentVolumeClaim: {
              claimName: data.metadata.name
            }
          }
        ]
      }
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: '${resourceName}-mongodb'
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      'radapp.io/resource': resourceName
      'radapp.io/component': 'mongodb'
    }
    ports: [
      {
        port: port
      }
    ]
  }
}

var endpoint = 'mongodb://${svc.metadata.name}.${namespace}.svc.cluster.local:${port}'

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${data.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${mongo.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${svc.metadata.name}'
  ]
  values: {
    database: database
    endpoint: endpoint
  }
  secrets: {
    #disable-next-line outputs-should-not-contain-secrets
    connectionString: 'mongodb://${username}:${uriComponent(mongoPassword)}@${svc.metadata.name}.${namespace}.svc.cluster.local:${port}/${uriComponent(database)}?authSource=admin'
  }
}
