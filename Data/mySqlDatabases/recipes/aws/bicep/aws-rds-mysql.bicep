// Radius.Data/mySqlDatabases on Amazon RDS for MySQL, for apps that run on Amazon EKS.
// Wired by recipe-packs/aws-eks. See recipe-packs/aws-eks/README.md for the
// network model and known limitations.

extension aws

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Name of the EKS cluster that runs the application. The DB instance joins the cluster security group, so workloads must be in that group or allowed by its rules on TCP 3306.')
param eksClusterName string

@description('Subnet IDs for the DB subnet group, comma-separated (subnet-0abc,subnet-0def) or as a JSON array. Use subnets in the EKS cluster VPC that span at least two Availability Zones.')
param subnetIds string

@description('RDS DB instance class.')
param instanceClass string = 'db.t3.micro'

@description('Allocated storage in GiB.')
@minValue(20)
param allocatedStorage int = 20

//////////////////////////////////////////
// MySQL variables
//////////////////////////////////////////

var properties = context.resource.properties
var database = properties.?database ?? 'mysql_db'
var version = properties.?version ?? '8.4'
var requireTls = (properties.?tls ?? 'required') == 'required'
var port = 3306

var trimmedSubnetIds = trim(subnetIds)
var subnetIdList = filter(
  map(startsWith(trimmedSubnetIds, '[') ? json(trimmedSubnetIds) : split(trimmedSubnetIds, ','), id => trim(string(id))),
  id => !empty(id)
)

// RDS names are unique per account and region, but Radius resource IDs are
// not: every installation uses the `local` plane, and a control plane can be
// recreated for each deploy. The hash adds the cluster and the Environment's
// Kubernetes namespace, which identify where the app runs and stay the same
// across installations. RDS stores names in lowercase; uniqueString is lowercase.
// uniqueString joins its arguments with `-`, which cluster names and namespaces
// can contain, so join those two with `/`, which neither allows.
var namespace = context.runtime.?kubernetes.?namespace ?? ''
var name = 'mysql-${uniqueString('${eksClusterName}/${namespace}', context.resource.id)}'

var tags = [
  {
    Key: 'radapp.io/application'
    Value: context.application == null ? '' : context.application.id
  }
  {
    Key: 'radapp.io/environment'
    Value: context.environment.id
  }
  {
    Key: 'radapp.io/resource'
    Value: context.resource.id
  }
]

//////////////////////////////////////////
// Network
//
// AWS assigns the ID of a new security group, and Radius can't manage AWS
// resources whose ID AWS assigns: each deploy creates one and then fails
// (radius-project/radius#13211). The instance joins the EKS cluster security group
// instead, which allows all traffic between its members. Workloads that aren't
// in that group, such as nodes with custom launch template security groups or
// pods with their own security groups, need a rule that allows TCP 3306. See
// recipe-packs/aws-eks/README.md. RDS listens only on that port.
//////////////////////////////////////////

resource eksCluster 'AWS.EKS/Cluster@default' existing = {
  alias: eksClusterName
  properties: {
    Name: eksClusterName
  }
}

resource subnetGroup 'AWS.RDS/DBSubnetGroup@default' = {
  alias: name
  properties: {
    DBSubnetGroupName: name
    DBSubnetGroupDescription: 'Radius MySQL ${context.resource.name}'
    SubnetIds: subnetIdList
    Tags: tags
  }
}

//////////////////////////////////////////
// MySQL server
//////////////////////////////////////////

resource parameterGroup 'AWS.RDS/DBParameterGroup@default' = {
  alias: name
  properties: {
    DBParameterGroupName: name
    Description: 'Radius MySQL ${context.resource.name}'
    Family: 'mysql${version}'
    // The AWS types model this free-form map as a closed object.
    Parameters: any({
      require_secure_transport: requireTls ? '1' : '0'
    })
    Tags: tags
  }
}

resource instance 'AWS.RDS/DBInstance@default' = {
  alias: name
  properties: {
    DBInstanceIdentifier: name
    Engine: 'mysql'
    EngineVersion: version
    DBInstanceClass: instanceClass
    AllocatedStorage: string(allocatedStorage)
    StorageType: 'gp3'
    StorageEncrypted: true
    DBName: database
    // password is x-radius-sensitive: Radius decrypts it only for the Recipe.
    MasterUsername: properties.username
    MasterUserPassword: properties.password
    Port: string(port)
    DBSubnetGroupName: subnetGroup.properties.DBSubnetGroupName
    DBParameterGroupName: parameterGroup.properties.DBParameterGroupName
    VPCSecurityGroups: [
      eksCluster.properties.ClusterSecurityGroupId
    ]
    PubliclyAccessible: false
    MultiAZ: false
    BackupRetentionPeriod: 1
    DeletionProtection: false
    // Delete through Cloud Control keeps a final snapshot. The tags show which
    // Radius resource it came from.
    CopyTagsToSnapshot: true
    Tags: tags
  }
}

//////////////////////////////////////////
// Output Radius result
//
// Same values as the Kubernetes Recipe, so one application definition works
// on every platform. The administrator credentials are developer-authored
// inputs, not Recipe outputs.
//////////////////////////////////////////

output result object = {
  values: {
    host: instance.properties.Endpoint.Address
    port: port
    database: database
  }
}
