extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Platform allowlist of Dapr app IDs. Resource scopes may narrow this list but cannot extend it. If empty, the resource must set nonempty scopes.')
param daprAllowedAppIds string[] = []

var resourceName = empty(inputErrors) ? context.resource.name : fail('Invalid Radius.Dapr/secretStores inputs. ${join(inputErrors, ' ')} Fix the inputs and deploy again.')
var applicationName = context.application != null ? context.application.name : ''
var environmentName = context.environment != null ? context.environment.name : ''
var resourceGroupName = split(context.resource.id, '/')[5]
var namespace = context.runtime.kubernetes.namespace
var resourceProperties = context.resource.properties

var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': applicationName
  'radapp.io/environment': environmentName
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': resourceGroupName
}

//////////////////////////////////////////
// Dapr component variables
//////////////////////////////////////////

// When the resource does not set a component type, deploy a
// secretstores.kubernetes component. It reads Kubernetes secrets in the
// namespace of the component and needs no backing infrastructure.
var requestedType = resourceProperties.?componentType ?? ''
var daprType = empty(requestedType) ? 'secretstores.kubernetes' : requestedType
var daprVersion = resourceProperties.?version ?? 'v1'

var componentMetadata = map(items(resourceProperties.?metadata ?? {}), entry => union({ name: entry.key }, entry.value))

// Never emit an empty list: Dapr treats it as namespace-wide access.
var requestedScopes = resourceProperties.?scopes
var componentScopes = requestedScopes ?? daprAllowedAppIds
var appIdCharacters = 'abcdefghijklmnopqrstuvwxyz0123456789'
var invalidAppIds = filter(concat(componentScopes, daprAllowedAppIds), appId => empty(appId) || length(appId) > 63 || !contains(appIdCharacters, substring(appId, 0, min(length(appId), 1))) || !contains(appIdCharacters, substring(appId, max(0, length(appId) - 1), min(length(appId), 1))) || !empty(filter(range(0, length(appId)), i => !contains('${appIdCharacters}-', substring(appId, i, 1)))))
var resourceMetadata = resourceProperties.?metadata ?? {}
var whitespace = [' ', '\t', '\r', '\n']
var invalidMetadata = filter(items(resourceMetadata), entry => empty(trim(entry.key)) || length(items(entry.value)) != 1 || (contains(entry.value, 'value') == contains(entry.value, 'secretKeyRef')) || (contains(entry.value, 'secretKeyRef') ? (length(items(entry.value.?secretKeyRef ?? {})) != 2 || empty(trim(entry.value.?secretKeyRef.?name ?? '')) || empty(trim(entry.value.?secretKeyRef.?key ?? ''))) : entry.value.?value == null))
var supportedProperties = [
  'environment'
  'application'
  'connections'
  'codeReference'
  'recipe'
  'status'
  'componentType'
  'version'
  'metadata'
  'scopes'
  'componentName'
]
var inputErrors = filter([
  empty(componentScopes) ? 'Set nonempty scopes or platform daprAllowedAppIds.' : ''
  !empty(invalidAppIds) ? 'scopes and daprAllowedAppIds must contain 1 to 63 lowercase letters, digits, or hyphens, with a letter or digit at each end.' : ''
  length(componentScopes) != length(union(componentScopes, componentScopes)) || length(daprAllowedAppIds) != length(union(daprAllowedAppIds, daprAllowedAppIds)) ? 'scopes and daprAllowedAppIds must not contain duplicate IDs.' : ''
  !empty(daprAllowedAppIds) && !empty(filter(componentScopes, appId => !contains(daprAllowedAppIds, appId))) ? 'scopes must be a subset of platform daprAllowedAppIds.' : ''
  !empty(invalidMetadata) ? 'Each metadata entry must set exactly one of value or secretKeyRef; secretKeyRef must contain nonempty name and key only.' : ''
  !empty(filter(items(resourceProperties), property => !contains(supportedProperties, property.key))) ? 'Unsupported resource property. Use the Radius.Dapr/secretStores schema.' : ''
  contains(resourceProperties, 'componentType') && (!startsWith(requestedType, 'secretstores.') || length(requestedType) <= length('secretstores.') || !empty(filter(whitespace, character => contains(requestedType, character)))) ? 'componentType must name a secretstores component without whitespace, or be omitted for the default.' : ''
  empty(daprVersion) || !empty(filter(whitespace, character => contains(daprVersion, character))) ? 'version must be nonempty and contain no whitespace, or omitted for v1.' : ''
], message => !empty(message))

//////////////////////////////////////////
// Dapr component
//////////////////////////////////////////

#disable-next-line BCP081
resource daprComponent 'dapr.io/Component@v1alpha1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: daprType
    version: daprVersion
    metadata: componentMetadata
  }
  scopes: componentScopes
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/dapr.io/Component/${resourceName}'
  ]
  values: {
    componentName: daprComponent.metadata.name
    version: daprVersion
  }
}
