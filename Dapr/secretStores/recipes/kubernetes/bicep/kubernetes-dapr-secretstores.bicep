extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Name of the Kubernetes ServiceAccount of the Dapr apps that read secrets. The Recipe gives this ServiceAccount read access to the secrets in `allowedSecrets` only. The Kubernetes Container Recipes in this repository use the `default` ServiceAccount.')
param daprServiceAccountName string = 'default'

var resourceName = context.resource.name
var applicationName = context.application != null ? context.application.name : ''
var environmentName = context.environment != null ? context.environment.name : ''
var resourceGroupName = split(context.resource.id, '/')[5]
var namespace = context.runtime.kubernetes.namespace
var resourceProperties = context.resource.properties

var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': applicationName
  'radapp.io/environment': environmentName
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': resourceGroupName
}

//////////////////////////////////////////
// Dapr component variables
//////////////////////////////////////////

// When the resource does not set a component type, deploy a
// secretstores.kubernetes component. It reads Kubernetes secrets in the
// namespace of the component and needs no backing infrastructure.
var requestedType = resourceProperties.?componentType ?? ''
var daprType = empty(requestedType) ? 'secretstores.kubernetes' : requestedType
var daprVersion = resourceProperties.?version ?? 'v1'

var componentMetadata = map(items(resourceProperties.?metadata ?? {}), entry => union({ name: entry.key }, entry.value))

// Dapr loads the component only into the listed app IDs. An empty list lets
// every Dapr app in the namespace load the component.
var componentScopes = resourceProperties.?scopes ?? []

// The Dapr sidecar reads Kubernetes secrets with the ServiceAccount of its Pod.
// The Recipe gives that ServiceAccount `get` access to the named secrets only.
// Without `allowedSecrets`, the Recipe gives no access, and Kubernetes denies
// all secret reads unless the platform engineer grants access.
var allowedSecrets = resourceProperties.?allowedSecrets ?? []
var grantSecretReads = !empty(allowedSecrets)
var secretReaderName = 'daprsecrets-${uniqueString(context.resource.id)}'

// Kubernetes RBAC applies only to the Kubernetes secret store. Reject
// `allowedSecrets` for other component types instead of ignoring it.
var componentType = grantSecretReads && daprType != 'secretstores.kubernetes'
  ? fail('allowedSecrets applies only to the secretstores.kubernetes component type. Remove allowedSecrets, or control access in the secret store that componentType selects.')
  : daprType

//////////////////////////////////////////
// Dapr component
//////////////////////////////////////////

#disable-next-line BCP081
resource daprComponent 'dapr.io/Component@v1alpha1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: componentType
    version: daprVersion
    metadata: componentMetadata
  }
  scopes: componentScopes
}

//////////////////////////////////////////
// Least-privilege secret reads
//////////////////////////////////////////

resource secretReaderRole 'rbac.authorization.k8s.io/Role@v1' = if (grantSecretReads) {
  metadata: {
    name: secretReaderName
    namespace: namespace
    labels: labels
  }
  rules: [
    {
      apiGroups: [
        ''
      ]
      resources: [
        'secrets'
      ]
      resourceNames: allowedSecrets
      verbs: [
        'get'
      ]
    }
  ]
}

resource secretReaderRoleBinding 'rbac.authorization.k8s.io/RoleBinding@v1' = if (grantSecretReads) {
  dependsOn: [
    secretReaderRole
  ]
  metadata: {
    name: secretReaderName
    namespace: namespace
    labels: labels
  }
  roleRef: {
    apiGroup: 'rbac.authorization.k8s.io'
    kind: 'Role'
    name: secretReaderName
  }
  subjects: [
    {
      kind: 'ServiceAccount'
      name: daprServiceAccountName
      namespace: namespace
    }
  ]
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

var componentResourceId = '/planes/kubernetes/local/namespaces/${namespace}/providers/dapr.io/Component/${resourceName}'
var secretReaderResourceIds = [
  '/planes/kubernetes/local/namespaces/${namespace}/providers/rbac.authorization.k8s.io/Role/${secretReaderName}'
  '/planes/kubernetes/local/namespaces/${namespace}/providers/rbac.authorization.k8s.io/RoleBinding/${secretReaderName}'
]

output result object = {
  resources: concat([componentResourceId], grantSecretReads ? secretReaderResourceIds : [])
  values: {
    componentName: daprComponent.metadata.name
    version: daprVersion
  }
}
