extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Platform allowlist of Dapr app IDs. Resource scopes may narrow this list but cannot extend it. If empty, the resource must set nonempty scopes.')
param daprAllowedAppIds string[] = []

@description('Sets the default Redis state store as the Dapr actor state store. Only one state store in a namespace can be the actor state store. Applies only when the resource does not set `componentType`.')
param actorStateStore bool = false

@description('Tag of the redis container image for the default state store.')
param redisImageTag string = '7-alpine'

@description('Memory request of the Redis container for the default state store.')
param redisMemoryRequest string = '128Mi'

@description('Memory limit of the Redis container for the default state store.')
param redisMemoryLimit string = '1024Mi'

var resourceName = empty(inputErrors) ? context.resource.name : fail('Invalid Radius.Dapr/stateStores inputs. ${join(inputErrors, ' ')} Fix the inputs and deploy again.')
var applicationName = context.application != null ? context.application.name : ''
var environmentName = context.environment != null ? context.environment.name : ''
var resourceGroupName = split(context.resource.id, '/')[5]
var namespace = context.runtime.kubernetes.namespace
var resourceProperties = context.resource.properties

var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': applicationName
  'radapp.io/environment': environmentName
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': resourceGroupName
}

//////////////////////////////////////////
// Dapr component variables
//////////////////////////////////////////

// When the resource does not set a component type, deploy a Redis instance and
// a state.redis component that uses it. When the resource sets a type, deploy
// only the Dapr component from the given type, version, and metadata.
var requestedType = resourceProperties.?componentType ?? ''
var useDefault = empty(requestedType)
var daprType = useDefault ? 'state.redis' : requestedType
var daprVersion = resourceProperties.?version ?? 'v1'
var secretStoreName = resourceProperties.?auth.?secretStore ?? ''

// Never emit an empty list: Dapr treats it as namespace-wide access.
var requestedScopes = resourceProperties.?scopes
var componentScopes = requestedScopes ?? daprAllowedAppIds
var appIdCharacters = 'abcdefghijklmnopqrstuvwxyz0123456789'
var invalidAppIds = filter(concat(componentScopes, daprAllowedAppIds), appId => empty(appId) || length(appId) > 63 || !contains(appIdCharacters, substring(appId, 0, min(length(appId), 1))) || !contains(appIdCharacters, substring(appId, max(0, length(appId) - 1), min(length(appId), 1))) || !empty(filter(range(0, length(appId)), i => !contains('${appIdCharacters}-', substring(appId, i, 1)))))
var resourceMetadata = resourceProperties.?metadata ?? {}
var whitespace = [' ', '\t', '\r', '\n']
var invalidMetadata = filter(items(resourceMetadata), entry => empty(trim(entry.key)) || length(items(entry.value)) != 1 || (contains(entry.value, 'value') == contains(entry.value, 'secretKeyRef')) || (contains(entry.value, 'secretKeyRef') ? (length(items(entry.value.?secretKeyRef ?? {})) != 2 || empty(trim(entry.value.?secretKeyRef.?name ?? '')) || empty(trim(entry.value.?secretKeyRef.?key ?? ''))) : entry.value.?value == null))
var supportedProperties = [
  'environment'
  'application'
  'connections'
  'codeReference'
  'recipe'
  'status'
  'componentType'
  'version'
  'metadata'
  'auth'
  'scopes'
  'componentName'
]
var inputErrors = filter([
  empty(componentScopes) ? 'Set nonempty scopes or platform daprAllowedAppIds.' : ''
  !empty(invalidAppIds) ? 'scopes and daprAllowedAppIds must contain 1 to 63 lowercase letters, digits, or hyphens, with a letter or digit at each end.' : ''
  length(componentScopes) != length(union(componentScopes, componentScopes)) || length(daprAllowedAppIds) != length(union(daprAllowedAppIds, daprAllowedAppIds)) ? 'scopes and daprAllowedAppIds must not contain duplicate IDs.' : ''
  !empty(daprAllowedAppIds) && !empty(filter(componentScopes, appId => !contains(daprAllowedAppIds, appId))) ? 'scopes must be a subset of platform daprAllowedAppIds.' : ''
  !empty(invalidMetadata) ? 'Each metadata entry must set exactly one of value or secretKeyRef; secretKeyRef must contain nonempty name and key only.' : ''
  !empty(filter(items(resourceProperties), property => !contains(supportedProperties, property.key))) ? 'Unsupported resource property. Use the Radius.Dapr/stateStores schema.' : ''
  contains(resourceProperties, 'componentType') && (!startsWith(requestedType, 'state.') || length(requestedType) <= length('state.') || !empty(filter(whitespace, character => contains(requestedType, character)))) ? 'componentType must name a state component without whitespace, or be omitted for the default.' : ''
  empty(daprVersion) || !empty(filter(whitespace, character => contains(daprVersion, character))) ? 'version must be nonempty and contain no whitespace, or omitted for v1.' : ''
  !empty(filter(items(resourceProperties.?auth ?? {}), property => property.key != 'secretStore')) || (contains(resourceProperties.?auth ?? {}, 'secretStore') && empty(trim(secretStoreName))) ? 'auth supports only a nonempty secretStore name.' : ''
], message => !empty(message))

var redisName = 'daprstate-${uniqueString(context.resource.id)}'
var redisPort = 6379
var redisHost = '${redisName}.${namespace}.svc.cluster.local:${redisPort}'

var defaultMetadata = useDefault
  ? {
      redisHost: {
        value: redisHost
      }
      redisPassword: {
        value: ''
      }
      actorStateStore: {
        value: actorStateStore ? 'true' : 'false'
      }
    }
  : {}

// Entries from the resource override the default entries.
var mergedMetadata = union(defaultMetadata, resourceProperties.?metadata ?? {})
var componentMetadata = map(items(mergedMetadata), entry => union({ name: entry.key }, entry.value))

var componentSpec = {
  type: daprType
  version: daprVersion
  metadata: componentMetadata
}

//////////////////////////////////////////
// Default Redis state store
//////////////////////////////////////////

var redisPodLabels = {
  'app.kubernetes.io/name': 'dapr-redis'
  'app.kubernetes.io/instance': redisName
  'radapp.io/application': applicationName
}

resource redis 'apps/Deployment@v1' = if (useDefault) {
  metadata: {
    name: redisName
    namespace: namespace
    labels: labels
  }
  spec: {
    // A single-replica, non-persistent Redis. Recreate stops the old Pod before
    // the new Pod starts, so two Redis instances never serve the same Service.
    strategy: {
      type: 'Recreate'
    }
    selector: {
      matchLabels: {
        'app.kubernetes.io/instance': redisName
      }
    }
    template: {
      metadata: {
        labels: redisPodLabels
      }
      spec: {
        containers: [
          {
            name: 'redis'
            image: 'redis:${redisImageTag}'
            ports: [
              {
                containerPort: redisPort
              }
            ]
            resources: {
              requests: {
                memory: redisMemoryRequest
              }
              limits: {
                memory: redisMemoryLimit
              }
            }
          }
        ]
      }
    }
  }
}

resource svc 'core/Service@v1' = if (useDefault) {
  metadata: {
    name: redisName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      'app.kubernetes.io/instance': redisName
    }
    ports: [
      {
        port: redisPort
      }
    ]
  }
}

//////////////////////////////////////////
// Dapr component
//////////////////////////////////////////

// Dapr defines `auth` at the Component root, next to `spec`. When `auth` is
// present, `auth.secretStore` is required. Bicep cannot add a root property
// conditionally, so the Recipe declares two components and deploys only one.
#disable-next-line BCP081
resource daprComponent 'dapr.io/Component@v1alpha1' = if (empty(secretStoreName)) {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: componentSpec
  scopes: componentScopes
}

#disable-next-line BCP081
resource daprComponentWithAuth 'dapr.io/Component@v1alpha1' = if (!empty(secretStoreName)) {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: componentSpec
  scopes: componentScopes
  auth: {
    secretStore: secretStoreName
  }
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

var componentResourceId = '/planes/kubernetes/local/namespaces/${namespace}/providers/dapr.io/Component/${resourceName}'
var redisResourceIds = [
  '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${redisName}'
  '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${redisName}'
]

output result object = {
  resources: concat([componentResourceId], useDefault ? redisResourceIds : [])
  values: {
    componentName: resourceName
    version: daprVersion
  }
}
