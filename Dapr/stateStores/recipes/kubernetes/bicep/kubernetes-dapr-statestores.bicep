extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Sets the default Redis state store as the Dapr actor state store. Only one state store in a namespace can be the actor state store. Applies only when the resource does not set `type`.')
param actorStateStore bool = false

@description('Tag of the redis container image for the default state store.')
param redisImageTag string = '7-alpine'

@description('Memory request of the Redis container for the default state store.')
param redisMemoryRequest string = '128Mi'

@description('Memory limit of the Redis container for the default state store.')
param redisMemoryLimit string = '1024Mi'

var resourceName = context.resource.name
var applicationName = context.application != null ? context.application.name : ''
var environmentName = context.environment != null ? context.environment.name : ''
var resourceGroupName = split(context.resource.id, '/')[5]
var namespace = context.runtime.kubernetes.namespace
var resourceProperties = context.resource.properties

var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': applicationName
  'radapp.io/environment': environmentName
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': resourceGroupName
}

//////////////////////////////////////////
// Dapr component variables
//////////////////////////////////////////

// When the resource does not set a component type, deploy a Redis instance and
// a state.redis component that uses it. When the resource sets a type, deploy
// only the Dapr component from the given type, version, and metadata.
var requestedType = resourceProperties.?type ?? ''
var useDefault = empty(requestedType)
var daprType = useDefault ? 'state.redis' : requestedType
var daprVersion = resourceProperties.?version ?? 'v1'
var secretStoreName = resourceProperties.?auth.?secretStore ?? ''

var redisName = 'daprstate-${uniqueString(context.resource.id)}'
var redisPort = 6379
var redisHost = '${redisName}.${namespace}.svc.cluster.local:${redisPort}'

var defaultMetadata = useDefault
  ? {
      redisHost: {
        value: redisHost
      }
      redisPassword: {
        value: ''
      }
      actorStateStore: {
        value: actorStateStore ? 'true' : 'false'
      }
    }
  : {}

// Entries from the resource override the default entries.
var mergedMetadata = union(defaultMetadata, resourceProperties.?metadata ?? {})
var componentMetadata = map(items(mergedMetadata), entry => union({ name: entry.key }, entry.value))

var componentSpec = {
  type: daprType
  version: daprVersion
  metadata: componentMetadata
}

//////////////////////////////////////////
// Default Redis state store
//////////////////////////////////////////

var redisPodLabels = {
  'app.kubernetes.io/name': 'dapr-redis'
  'app.kubernetes.io/instance': redisName
  'radapp.io/application': applicationName
}

resource redis 'apps/Deployment@v1' = if (useDefault) {
  metadata: {
    name: redisName
    namespace: namespace
    labels: labels
  }
  spec: {
    // A single-replica, non-persistent Redis. Recreate stops the old Pod before
    // the new Pod starts, so two Redis instances never serve the same Service.
    strategy: {
      type: 'Recreate'
    }
    selector: {
      matchLabels: {
        'app.kubernetes.io/instance': redisName
      }
    }
    template: {
      metadata: {
        labels: redisPodLabels
      }
      spec: {
        containers: [
          {
            name: 'redis'
            image: 'redis:${redisImageTag}'
            ports: [
              {
                containerPort: redisPort
              }
            ]
            resources: {
              requests: {
                memory: redisMemoryRequest
              }
              limits: {
                memory: redisMemoryLimit
              }
            }
          }
        ]
      }
    }
  }
}

resource svc 'core/Service@v1' = if (useDefault) {
  metadata: {
    name: redisName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      'app.kubernetes.io/instance': redisName
    }
    ports: [
      {
        port: redisPort
      }
    ]
  }
}

//////////////////////////////////////////
// Dapr component
//////////////////////////////////////////

// Dapr defines `auth` at the Component root, next to `spec`. When `auth` is
// present, `auth.secretStore` is required. Bicep cannot add a root property
// conditionally, so the Recipe declares two components and deploys only one.
#disable-next-line BCP081
resource daprComponent 'dapr.io/Component@v1alpha1' = if (empty(secretStoreName)) {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: componentSpec
}

#disable-next-line BCP081
resource daprComponentWithAuth 'dapr.io/Component@v1alpha1' = if (!empty(secretStoreName)) {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: componentSpec
  auth: {
    secretStore: secretStoreName
  }
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

var componentResourceId = '/planes/kubernetes/local/namespaces/${namespace}/providers/dapr.io/Component/${resourceName}'
var redisResourceIds = [
  '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${redisName}'
  '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${redisName}'
]

output result object = {
  resources: concat([componentResourceId], useDefault ? redisResourceIds : [])
  values: {
    componentName: resourceName
    version: daprVersion
  }
}
