extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes


//////////////////////////////////////////
// Common Radius variables
//////////////////////////////////////////

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Random master key for the search server. Generated on every deployment.')
@secure()
param generatedApiKey string = newGuid()

var resourceName = context.resource.name
// A unique per-resource name so two search resources that share a display name
// (or the same name across recreates) never collide on their Kubernetes objects.
var uniqueName = '${resourceName}-${uniqueString(context.resource.id)}'
var applicationName = context.application != null ? context.application.name : ''
var environmentName = context.environment != null ? context.environment.name : ''
var resourceGroupName = split(context.resource.id, '/')[5]
var namespace = context.runtime.kubernetes.namespace

//////////////////////////////////////////
// Meilisearch variables
//////////////////////////////////////////

var tag string = 'v1.54.3'
var port = 7700
var keySecretName = '${uniqueName}-master-key'

// Selector label derived from the resource ID. Pods and the Service match on it
// so another workload with the same display name is never selected.
var selectorLabels = {
  'radapp.io/resource-id': uniqueString(context.resource.id)
}

var labels = union(selectorLabels, {
  'radapp.io/resource':       resourceName
  'radapp.io/application':    applicationName
  'radapp.io/environment':    environmentName
  'radapp.io/resource-type':  replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': resourceGroupName
})

//////////////////////////////////////////
// Master key
//
// Radius.AI/search has no developer-authored credentials, so the Recipe
// generates the master key. It is stored in a Kubernetes Secret so the Pod
// spec references it through secretKeyRef instead of carrying it inline.
//////////////////////////////////////////

resource masterKey 'core/Secret@v1' = {
  metadata: {
    name: keySecretName
    namespace: namespace
    labels: labels
  }
  stringData: {
    MEILI_MASTER_KEY: generatedApiKey
  }
}

//////////////////////////////////////////
// Meilisearch Deployment
//////////////////////////////////////////

resource dataClaim 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: '${uniqueName}-data'
    namespace: namespace
    labels: labels
  }
  spec: {
    accessModes: [
      'ReadWriteOnce'
    ]
    resources: {
      requests: {
        storage: '1Gi'
      }
    }
  }
}

resource meilisearch 'apps/Deployment@v1' = {
  metadata: {
    name: uniqueName
    namespace: namespace
    labels: labels
  }
  spec: {
    // A single-replica server. Meilisearch locks its database
    // directory, so Recreate tears the old Pod down before the new one starts
    // instead of briefly running two (the default RollingUpdate).
    strategy: {
      type: 'Recreate'
    }
    selector: {
      matchLabels: selectorLabels
    }
    template: {
      metadata: {
        labels: labels
        annotations: {
          // A new master key changes the Pod template so the server restarts
          // and reads the updated Secret during deployment.
          'radapp.io/generated-api-key-hash': uniqueString(generatedApiKey)
        }
      }
      spec: {
        containers: [
          {
            // The Meilisearch server, which serves its REST API on port 7700.
            name: 'meilisearch'
            image: 'getmeili/meilisearch:${tag}'
            ports: [
              {
                name: 'http'
                containerPort: port
              }
            ]
            env: [
              {
                // Every request except /health must carry the master key or
                // a key derived from it.
                name: 'MEILI_MASTER_KEY'
                valueFrom: {
                  secretKeyRef: {
                    name: masterKey.metadata.name
                    key: 'MEILI_MASTER_KEY'
                  }
                }
              }
              {
                // Production mode requires the master key and disables the
                // built-in search preview UI.
                name: 'MEILI_ENV'
                value: 'production'
              }
              {
                name: 'MEILI_NO_ANALYTICS'
                value: 'true'
              }
            ]
            readinessProbe: {
              httpGet: {
                path: '/health'
                port: 'http'
              }
              initialDelaySeconds: 2
              periodSeconds: 5
            }
            resources: {
              requests: {
                memory: '256Mi'
              }
            }
            volumeMounts: [
              {
                name: 'data'
                mountPath: '/meili_data'
              }
            ]
          }
        ]
        volumes: [
          {
            name: 'data'
            persistentVolumeClaim: {
              claimName: dataClaim.metadata.name
            }
          }
        ]
      }
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: uniqueName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: selectorLabels
    ports: [
      {
        port: port
      }
    ]
  }
}

//////////////////////////////////////////
// Output Radius result
//////////////////////////////////////////

var host = '${svc.metadata.name}.${svc.metadata.namespace}.svc.cluster.local'

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${keySecretName}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${dataClaim.metadata.name}'
    '/planes/kubernetes/local/namespaces/${svc.metadata.namespace}/providers/core/Service/${svc.metadata.name}'
    '/planes/kubernetes/local/namespaces/${meilisearch.metadata.namespace}/providers/apps/Deployment/${meilisearch.metadata.name}'
  ]
  values: {
    endpoint: 'http://${host}:${port}'
  }
  secrets: {
    // The master key. Radius materializes it into the managed
    // Radius.Security/secrets resource; it is never written onto the resource.
    apiKey: generatedApiKey
  }
}
