extension kubernetes with {
  kubeConfig: ''
  namespace: context.runtime.kubernetes.namespace
} as kubernetes

@description('Information about the resource calling this Recipe. Generated by Radius.')
param context object

@secure()
@minLength(88)
@maxLength(88)
@description('Platform-supplied base64 encoding of 64 random bytes. Keep stable across deployments. Required; no emulator default key is used.')
param objectStorageAccountKey string

@description('Persistent volume size. The cluster must have a matching volume provisioner.')
param objectStorageStorageSize string = '1Gi'

@description('Storage class for the persistent volume. Empty uses the cluster default.')
param objectStorageStorageClassName string = ''

var resourceName = '${context.resource.name}-blob'
var namespace = context.runtime.kubernetes.namespace
var accountName = 'radiusstorage'
var containerName = context.resource.properties.?containerName ?? 'data'
var labels = {
  'radapp.io/resource': resourceName
  'radapp.io/application': context.?application.?name ?? ''
  'radapp.io/environment': context.?environment.?name ?? ''
  'radapp.io/resource-type': replace(context.resource.type, '/', '-')
  'radapp.io/resource-group': split(context.resource.id, '/')[5]
}

// This authenticated probe creates the container before the Service serves traffic.
// Azurite path-style requests repeat the account in the canonical resource.
var initializeContainer = '''
const http = require('http');
const crypto = require('crypto');
const [account, key] = process.env.AZURITE_ACCOUNTS.split(':');
const container = process.env.CONTAINER_NAME;
if (!/^[A-Za-z0-9+/]{86}==$/.test(key) || Buffer.from(key, 'base64').length !== 64 ||
    !/^(?!.*--)[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$/.test(container)) {
  console.error('Invalid storage key or Blob container name');
  process.exit(1);
}
const date = new Date().toUTCString();
const headers = 'x-ms-date:' + date + '\nx-ms-version:2021-12-02\n';
const canonical = '/' + account + '/' + account + '/' + container + '\nrestype:container';
const message = ['PUT', '', '', '', '', '', '', '', '', '', '', ''].join('\n') + '\n' + headers + canonical;
const signature = crypto.createHmac('sha256', Buffer.from(key, 'base64')).update(message).digest('base64');
const request = http.request({
  host: '127.0.0.1', port: 10000, method: 'PUT',
  path: '/' + account + '/' + container + '?restype=container',
  headers: { 'x-ms-date': date, 'x-ms-version': '2021-12-02', 'Content-Length': 0,
    Authorization: 'SharedKey ' + account + ':' + signature }
}, response => {
  response.resume();
  if (response.statusCode !== 201 &&
      !(response.statusCode === 409 && response.headers['x-ms-error-code'] === 'ContainerAlreadyExists')) {
    console.error('Blob container initialization failed: HTTP ' + response.statusCode);
    process.exitCode = 1;
  }
});
request.setTimeout(3000, () => request.destroy(new Error('Blob initialization timeout')));
request.on('error', error => { console.error(error.message); process.exitCode = 1; });
request.end();
'''

resource credentials 'core/Secret@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  type: 'Opaque'
  data: {
    accounts: base64('${accountName}:${objectStorageAccountKey}')
  }
}

resource storage 'core/PersistentVolumeClaim@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: union({
    accessModes: ['ReadWriteOnce']
    resources: {
      requests: {
        storage: objectStorageStorageSize
      }
    }
  }, empty(objectStorageStorageClassName) ? {} : { storageClassName: objectStorageStorageClassName })
}

resource blob 'apps/Deployment@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    replicas: 1
    strategy: {
      type: 'Recreate'
    }
    selector: {
      matchLabels: {
        'radapp.io/resource': resourceName
      }
    }
    template: {
      metadata: {
        labels: labels
        annotations: {
          // Restart on key rotation; Secret-backed environment variables do not refresh.
          'radapp.io/credential-hash': guid(objectStorageAccountKey)
        }
      }
      spec: {
        automountServiceAccountToken: false
        containers: [
          {
            name: 'azurite'
            image: 'mcr.microsoft.com/azure-storage/azurite:3.35.0'
            command: ['azurite-blob']
            args: [
              '--blobHost'
              '0.0.0.0'
              '--location'
              '/data'
              '--disableProductStyleUrl'
              '--disableTelemetry'
              '--silent'
            ]
            env: [
              {
                name: 'AZURITE_ACCOUNTS'
                valueFrom: {
                  secretKeyRef: {
                    name: credentials.metadata.name
                    key: 'accounts'
                  }
                }
              }
              {
                name: 'CONTAINER_NAME'
                value: containerName
              }
            ]
            ports: [{ name: 'blob', containerPort: 10000 }]
            resources: {
              requests: {
                cpu: '100m'
                memory: '256Mi'
              }
              limits: {
                memory: '512Mi'
              }
            }
            volumeMounts: [{ name: 'data', mountPath: '/data' }]
            startupProbe: {
              exec: {
                command: ['node', '-e', initializeContainer]
              }
              periodSeconds: 5
              timeoutSeconds: 5
              failureThreshold: 60
            }
            readinessProbe: {
              tcpSocket: { port: 'blob' }
              periodSeconds: 5
            }
            livenessProbe: {
              tcpSocket: { port: 'blob' }
              periodSeconds: 10
            }
          }
        ]
        volumes: [
          {
            name: 'data'
            persistentVolumeClaim: {
              claimName: storage.metadata.name
            }
          }
        ]
      }
    }
  }
}

resource svc 'core/Service@v1' = {
  metadata: {
    name: resourceName
    namespace: namespace
    labels: labels
  }
  spec: {
    type: 'ClusterIP'
    selector: {
      'radapp.io/resource': resourceName
    }
    ports: [{ port: 10000 }]
  }
}

var endpoint = 'http://${svc.metadata.name}.${namespace}.svc.cluster.local:10000/${accountName}'

output result object = {
  resources: [
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Secret/${credentials.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/PersistentVolumeClaim/${storage.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/apps/Deployment/${blob.metadata.name}'
    '/planes/kubernetes/local/namespaces/${namespace}/providers/core/Service/${svc.metadata.name}'
  ]
  values: {
    endpoint: endpoint
    accountName: accountName
  }
  secrets: {
    // Radius requires these outputs to populate its managed secret.
#disable-next-line outputs-should-not-contain-secrets
    accountKey: objectStorageAccountKey
#disable-next-line outputs-should-not-contain-secrets
    connectionString: 'DefaultEndpointsProtocol=http;AccountName=${accountName};AccountKey=${objectStorageAccountKey};BlobEndpoint=${endpoint};'
  }
}
