// Radius.Compute/containers on Amazon EKS, wired by recipe-packs/aws-eks.
// Runs the Kubernetes Recipe and gives the pods their own IAM role through EKS
// Pod Identity, with the permissions that connected resources publish in
// awsIamPolicy. See recipe-packs/aws-eks/README.md.

extension aws

@description('Information about what resource is calling this Recipe. Generated by Radius.')
param context object

@description('Name of the EKS cluster that runs the application. The Pod Identity association is created on this cluster.')
param eksClusterName string

// Required: Radius doesn't delete resources that a Recipe stops creating, so
// a Recipe that skipped the role without a boundary would leave it behind.
@description('ARN of the IAM managed policy that is the permissions boundary of the app roles. The roles use its path.')
param appPermissionsBoundaryArn string

// The roles share the boundary's path, so a deploy identity can limit role
// management to one path and require the boundaries under it.
var boundaryPolicyName = contains(appPermissionsBoundaryArn, ':policy/')
  ? split(appPermissionsBoundaryArn, ':policy/')[1]
  : fail('Set appPermissionsBoundaryArn on the aws-eks Recipe Pack to the ARN of an IAM managed policy, such as arn:aws:iam::123456789012:policy/radius/apps/my-repo/my-env/radius-app-boundary-my-repo-my-env. It is "${appPermissionsBoundaryArn}".')
var rolePath = '/${substring(boundaryPolicyName, 0, lastIndexOf(boundaryPolicyName, '/') + 1)}'
var name = toLower(context.resource.name)
var namespace = context.runtime.kubernetes.namespace
var account = context.aws.account
var region = context.aws.region
var serviceAccountName = 'radius-app-${name}'

// IAM role names are unique per account and Radius resource IDs repeat across
// installations, so the hash covers the path, region, cluster, and namespace.
// Cloud Control reads the role by name without its path, so deploy identities
// need GetRole on role/radius-app-*.
var roleName = '${take('radius-app-${name}', 50)}-${uniqueString('${rolePath}${region}/${eksClusterName}/${namespace}', context.resource.id)}'

var tags = [
  {
    Key: 'radapp.io/application'
    Value: context.application == null ? '' : context.application.id
  }
  {
    Key: 'radapp.io/environment'
    Value: context.environment.id
  }
  {
    Key: 'radapp.io/resource'
    Value: context.resource.id
  }
]

// An AWS resource type that apps reach with IAM credentials returns the policy
// its consumers need as awsIamPolicy, a JSON policy document whose Statement is
// an array. Sids are dropped because IAM rejects duplicates across connections.
var connectionStatements = reduce(items(context.resource.?connections ?? {}), [], (acc, conn) =>
  conn.value.?properties.?awsIamPolicy == null
    ? acc
    : concat(acc, map(json(conn.value.properties.awsIamPolicy).Statement, statement =>
        toObject(filter(items(statement), entry => entry.key != 'Sid'), entry => entry.key, entry => entry.value)
      ))
)

// IAM rejects a policy without statements. A role without AWS connections keeps
// a policy that denies everything, so every deploy updates the same policy.
var policyDocument = {
  Version: '2012-10-17'
  Statement: empty(connectionStatements) ? [{ Effect: 'Deny', Action: '*', Resource: '*' }] : connectionStatements
}

resource role 'AWS.IAM/Role@default' = {
  alias: roleName
  properties: {
    RoleName: roleName
    Path: rolePath
    PermissionsBoundary: appPermissionsBoundaryArn
    AssumeRolePolicyDocument: any({
      Version: '2012-10-17'
      Statement: [
        {
          Effect: 'Allow'
          Principal: { Service: 'pods.eks.amazonaws.com' }
          Action: ['sts:AssumeRole', 'sts:TagSession']
          Condition: {
            StringEquals: {
              'aws:SourceAccount': account
              'aws:SourceArn': 'arn:aws:eks:${region}:${account}:cluster/${eksClusterName}'
              'aws:RequestTag/kubernetes-namespace': namespace
              'aws:RequestTag/kubernetes-service-account': serviceAccountName
            }
          }
        }
      ]
    })
    Policies: [
      {
        PolicyName: 'connections'
        PolicyDocument: any(policyDocument)
      }
    ]
    Tags: tags
  }
}

// A pod started before its association never gets credentials, so the
// Deployment waits for it.
resource association 'AWS.EKS/PodIdentityAssociation@default' = {
  alias: '${eksClusterName}-${namespace}-${serviceAccountName}'
  properties: {
    ClusterName: eksClusterName
    Namespace: namespace
    ServiceAccount: serviceAccountName
    RoleArn: role.properties.Arn
    Tags: tags
  }
}

// Recipes of one group share a deployment scope, so the nested deployment name
// is unique per resource. Concurrent deploys would otherwise read each other's
// outputs.
module kube '../../kubernetes/bicep/kubernetes-containers.bicep' = {
  name: 'containers-${uniqueString(context.resource.id)}'
  params: {
    context: context
    serviceAccountName: serviceAccountName
  }
  dependsOn: [association]
}

output result object = kube.outputs.result
